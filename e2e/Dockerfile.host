FROM golang:1.22-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
ENV GOTOOLCHAIN=auto
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /host ./cmd/host

FROM alpine:latest
RUN apk add --no-cache ca-certificates
COPY --from=builder /host /usr/local/bin/host
COPY --from=builder /app/e2e/host-docker.yaml /etc/host.yaml
RUN mkdir -p /data
EXPOSE 7860
CMD ["host", "-f", "/etc/host.yaml"]
