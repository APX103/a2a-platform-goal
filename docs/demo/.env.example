# LLM API Configuration
# Copy this file to .env and fill in your API key:
#   cp .env.example .env

# Required: Your LLM API key (not committed to git)
LLM_API_KEY=your-api-key-here

# Optional: LLM API base URL (default: https://token-plan-cn.xiaomimimo.com/v1)
# LLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1

# Optional: LLM model name (default: mimo-v2.5-pro)
# LLM_MODEL=mimo-v2.5-pro
